[Unit]
Description=SaaS Starter — Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/saas-starter
EnvironmentFile=/var/www/saas-starter/.env
ExecStart=/var/www/saas-starter/.venv/bin/gunicorn \
    saas_starter.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 30 \
    --access-logfile /var/log/saas-starter/access.log \
    --error-logfile /var/log/saas-starter/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
