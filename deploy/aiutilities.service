[Unit]
Description=AIUtilities — Gunicorn
After=network.target

[Service]
User=siteadmin
Group=www-data
WorkingDirectory=/home/siteadmin/aiutilities
EnvironmentFile=/home/siteadmin/aiutilities/.env
ExecStart=/home/siteadmin/aiutilities/.venv/bin/gunicorn \
    saas_starter.wsgi:application \
    --bind 127.0.0.1:8008 \
    --workers 3 \
    --timeout 60 \
    --access-logfile /var/log/aiutilities/access.log \
    --error-logfile /var/log/aiutilities/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
