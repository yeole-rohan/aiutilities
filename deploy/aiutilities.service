[Unit]
Description=AIUtilities — Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/aiutilities
EnvironmentFile=/var/www/aiutilities/.env
ExecStart=/var/www/aiutilities/.venv/bin/gunicorn \
    saas_starter.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile /var/log/aiutilities/access.log \
    --error-logfile /var/log/aiutilities/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
