[Unit]
Description=SaaS Starter — Celery Worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/saas-starter
EnvironmentFile=/var/www/saas-starter/.env
ExecStart=/var/www/saas-starter/.venv/bin/celery \
    -A saas_starter worker -l info \
    --logfile=/var/log/saas-starter/celery.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
