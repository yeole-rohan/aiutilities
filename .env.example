# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite — works immediately, no Docker or postgres install needed.
# Switch to postgres when you're ready for production or team dev.
DATABASE_URL=sqlite:///db.sqlite3

# postgres (local, no Docker):
# DATABASE_URL=postgres://youruser:yourpass@localhost:5432/saas

# postgres via Docker Compose — uncomment when running: docker compose up
# DATABASE_URL=postgres://saas:saas@db:5432/saas

# ── Redis + Celery ────────────────────────────────────────────────────────────
# Default: disabled. Celery tasks run synchronously in dev (CELERY_TASK_ALWAYS_EAGER).
# Uncomment when running via Docker Compose or with a local Redis install.
# REDIS_URL=redis://localhost:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.postmarkapp.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-api-token
# EMAIL_HOST_PASSWORD=your-api-token

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── Lemon Squeezy (global / India-friendly alternative to Stripe) ─────────────
LEMON_SQUEEZY_SIGNING_SECRET=
LS_PRO_VARIANT_ID=
LS_TEAM_VARIANT_ID=

# ── Sentry (production only) ──────────────────────────────────────────────────
SENTRY_DSN=
