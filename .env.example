# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ───────────────────────────────────────────────────────────────────
#
# Choose ONE of the two paths below. Delete the other.
#
# PATH A — Local (no Docker)
#   Option 1: SQLite — no install needed, works immediately.
DATABASE_URL=sqlite:///db.sqlite3
#   Option 2: Local postgres — see SETUP.md §2B for user/database creation steps.
# DATABASE_URL=postgres://saas:saas@localhost:5432/saas
#
# PATH B — Docker Compose
#   Leave DATABASE_URL commented out here.
#   docker-compose.yml sets DATABASE_URL=postgres://saas:saas@db:5432/saas
#   automatically. 'db' is a Docker internal hostname — it only resolves
#   inside the Docker network and will error if used outside Docker.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis + Celery ────────────────────────────────────────────────────────────
# PATH A — Local: leave commented. Dev settings run tasks synchronously, no Redis needed.
# REDIS_URL=redis://localhost:6379/0

# PATH B — Docker Compose: leave commented. docker-compose.yml sets this automatically.
# REDIS_URL=redis://redis:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
# 'console' prints emails to the terminal — no SMTP needed for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Production SMTP (e.g. Postmark):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.postmarkapp.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-api-token
# EMAIL_HOST_PASSWORD=your-api-token

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Leave blank until you are ready to configure social login.
# See SETUP.md §6 for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Leave blank until you are ready to configure billing.
# See SETUP.md §7 for setup steps.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── Lemon Squeezy (India / global alternative to Stripe) ─────────────────────
# See SETUP.md §8 for setup steps.
LEMON_SQUEEZY_SIGNING_SECRET=
LS_PRO_VARIANT_ID=
LS_TEAM_VARIANT_ID=

# ── Sentry (production only) ──────────────────────────────────────────────────
SENTRY_DSN=
